# Server environment example for SiteBuilder AI
# Copy this file to `.env` and fill real values. NEVER commit real secrets to source control.

# Postgres connection string (Prisma uses this)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# OpenAI / OpenRouter API key (used by server/configs/openai.ts)
AI_API_KEY=

# Stripe keys for payments and webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# better-auth settings (session/identity provider)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Origins allowed for CORS (comma separated)
TRUSTED_ORIGINS=http://localhost:5173

# Runtime / server settings
NODE_ENV=development
PORT=3000

# Optional: Sentry DSN for error monitoring
SENTRY_DSN=

# Optional: session secret for your auth/session implementation
SESSION_SECRET=

# Notes:
# - After creating `.env`, restart the server so the new env values are loaded.
# - Keep secrets in a secure store in production (Vault, GitHub Secrets, environment, etc.).
# - If you need a sample Postgres URL for local development, use a locally-running Postgres instance or a managed provider.
